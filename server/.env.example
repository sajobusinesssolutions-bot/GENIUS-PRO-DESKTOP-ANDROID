# Genius POS server — configuration template.
#
# Copy to `server/.env` ON THE VPS and fill in the real values. `.env` is
# git-ignored; this file, with placeholders only, is the one that is committed.
#
# Nothing in here belongs in the mobile app. An APK can be unzipped by anyone,
# so a secret shipped inside one is not a secret. The phone only ever knows the
# server's URL.

# ---------------------------------------------------------------- core

NODE_ENV=production
PORT=8080

# The public origin, used to build the OAuth redirect URI. Must match exactly
# what is registered in the Google console, including the scheme and any port.
PUBLIC_ORIGIN=https://example.com

# ---------------------------------------------------------------- database

DATABASE_URL=postgres://genius:CHANGE_ME@127.0.0.1:5432/genius

# ---------------------------------------------------------------- sessions

# 32+ random bytes, base64. Generate with:  openssl rand -base64 48
ACCESS_TOKEN_SECRET=CHANGE_ME
REFRESH_TOKEN_PEPPER=CHANGE_ME

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=90d

# ---------------------------------------------------------------- google sign-in
#
# A **Web application** OAuth client, not an Android one: the exchange happens
# here, using the secret below, so no package name or SHA-1 fingerprint is
# involved and one client covers Android, iOS and web.
#
# Register this exact redirect URI on the client:
#   ${PUBLIC_ORIGIN}/v1/auth/google/callback
#
# The client ID is public — it appears in every redirect URL. The secret is not.

GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME

# Where the server sends the browser once it is done. Must match the app's
# scheme in app.json.
APP_RETURN_URL=geniuspos://oauth

# How long the one-time ticket in that redirect stays good. Short on purpose: a
# redirect URL is written to browser history and to the system log.
GOOGLE_TICKET_TTL=120s

# ---------------------------------------------------------------- licensing
#
# Ed25519 keypair. The server signs licence tokens with the private key; the app
# has only the public half embedded, and verifies offline. Generate with:
#
#   openssl genpkey -algorithm ed25519 -out licence.key
#   openssl pkey -in licence.key -pubout -out licence.pub
#
# Keep licence.key off this repository and out of any backup the app can reach.

LICENCE_PRIVATE_KEY_PATH=/etc/genius/licence.key
LICENCE_TOKEN_TTL=30d

# ---------------------------------------------------------------- email
#
# Used for the six-digit confirmation and password-reset codes. Without this,
# nobody can create an account or recover one.

# Use a transactional provider, not this VPS. A fresh server IP has no sending
# reputation and most hosts block outbound port 25, so self-hosted OTP codes end
# up in spam — which looks to a shopkeeper like the app being broken.
#
# Whichever you pick, add its SPF, DKIM and DMARC records at your DNS first.
# Without them the mail is delivered to the spam folder no matter who sends it.
#
# Formats (port 587 is STARTTLS and takes smtp://, 465 is implicit TLS, smtps://):
#   Brevo       smtp://USER%40example.com:SMTP_KEY@smtp-relay.brevo.com:587
#   Resend      smtps://resend:RESEND_API_KEY@smtp.resend.com:465
#   MailerSend  smtp://USERNAME:PASSWORD@smtp.mailersend.net:587
#   ZeptoMail   smtps://emailapikey:ZEPTO_KEY@smtp.zeptomail.com:465
#   Amazon SES  smtp://SMTP_USER:SMTP_PASS@email-smtp.eu-west-1.amazonaws.com:587
#
# Any @ or : inside a username or password must be percent-encoded.

SMTP_URL=smtps://user:CHANGE_ME@smtp.example.com:465

# Must be at a domain the provider has verified, or it will refuse to send.
MAIL_FROM="Genius POS <no-reply@example.com>"

# Short enough to be worth little if the email is read by someone else, long
# enough to type from another phone.
OTP_TTL=10m

# ---------------------------------------------------------------- object storage
#
# Snapshots, archived operations and database backups. Deliberately a DIFFERENT
# provider from the VPS: a backup that dies with the box is not a backup.

S3_ENDPOINT=https://s3.example.com
S3_BUCKET=genius-backups
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# ---------------------------------------------------------------- limits

RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_SYNC_PER_MIN=120
SYNC_PULL_DEFAULT=500
